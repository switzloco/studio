rules_version = '2';

// ===============================================================
// Assumed Data Model & Security Invariants
// ===============================================================
//
// Collection: /users/{userId}
//   - Owner-managed health, onboarding, and outreach fields (e.g.,
//     dailyCaloriesIn, dailyProteinG, dailyCarbsG, dailyPlantG,
//     dailyCaloriesOut, steps, hrv, sleepHours, recoveryStatus,
//     weightKg, heightCm, bodyFatPct, visceralFatPoints, history,
//     lastActiveDate, onboardingDay, onboardingComplete, isAnonymous,
//     updatedAt, createdAt, outreachEnabled, outreachEmail,
//     outreachDiscordUserId).
//   - Server-managed billing/entitlement fields (written exclusively
//     via Admin SDK in Stripe webhooks, verify-session, and server
//     entitlement actions; client create/update/removal is blocked):
//       entitlementTier, bonusAiAudits, redeemedFounderCode,
//       redeemedGiftCode, subscriptionPlan, stripeCustomerId,
//       stripeSubscriptionId, subscriptionStatus, cancelAtPeriodEnd,
//       currentPeriodEnd.
//
// Subcollections under /users/{userId}:
//   - preferences, logs, food_log, exercise_log, fast_log,
//     chat_sessions, campaign, campaign_briefs, shared_data
//     (strictly owner-scoped).
//
// Collection: /shared_meals/{shareId}
//   - Publicly shareable meal snapshots (link-as-bearer-token).
//     Single-doc get allowed unless revoked; list and client writes denied.
//
// Unmatched paths are denied by default.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Server-managed billing and entitlement fields that clients must never
    // set on create or add/modify/remove on update.
    function protectedBillingFields() {
      return [
        'entitlementTier',
        'bonusAiAudits',
        'redeemedFounderCode',
        'redeemedGiftCode',
        'subscriptionPlan',
        'stripeCustomerId',
        'stripeSubscriptionId',
        'subscriptionStatus',
        'cancelAtPeriodEnd',
        'currentPeriodEnd'
      ];
    }

    function hasNoProtectedBillingFields() {
      return !request.resource.data.keys().hasAny(protectedBillingFields());
    }

    function protectedBillingFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedBillingFields());
    }

    match /users/{userId} {
      allow get, list, delete: if isOwner(userId);
      allow create: if isOwner(userId) && hasNoProtectedBillingFields();
      allow update: if isOwner(userId) && protectedBillingFieldsUnchanged();

      match /preferences/{prefId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /logs/{logId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /food_log/{entryId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /exercise_log/{entryId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /fast_log/{entryId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /chat_sessions/{chatId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /campaign/{docId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /campaign_briefs/{isoDate} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
      match /shared_data/{entryId} {
        allow get, list, create, update, delete: if isOwner(userId);
      }
    }

    // Publicly shareable meal snapshots (link-as-bearer-token). The random
    // doc ID is the unguessable token. A single doc is readable by anyone with
    // the link until it is revoked; enumeration (list) is disabled. All writes
    // go through trusted server actions on the Admin SDK, which bypass rules —
    // so direct client writes are denied here.
    match /shared_meals/{shareId} {
      allow get: if resource.data.revoked != true;
      allow list, create, update, delete: if false;
    }
  }
}
