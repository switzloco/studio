# Copy this file to .env.local and fill in your values.
# Zero secret API keys are committed to version control.

# ── Firebase Web SDK (`firebase@latest` >= 13.x) ─────────────────────────────
# Public client web app identifiers from Firebase Console -> Project Settings.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ── Firebase App Check (`firebase/app-check` — Required for #BuildHybridAI) ──
# ReCaptcha Enterprise site key from Firebase Console -> App Check.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Debug token for local/judge testing (`true` auto-generates a console debug token in dev,
# or paste a registered UUID debug token from Firebase Console -> App Check -> Manage debug tokens).
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=true

# ── Chrome Built-in AI Origin Trial (`window.LanguageModel` / Gemini Nano) ───
# Origin Trial token enabling Chrome's Prompt API on production domains (e.g. cfofitness.app).
# Localhost works automatically when Chrome Prompt API flags are enabled.
NEXT_PUBLIC_CHROME_ORIGIN_TRIAL_TOKEN=

# ── Server-Side Genkit / Multi-Tool Cloud Coaching (`/api/chat`) ─────────────
# Optional for Hybrid On-Device / Firebase AI Logic client features; required for
# server-side multi-tool Genkit agent routes (`/api/chat`).
# Get a key at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=
CFO_MODEL=

# ── Arize Phoenix Observability (Optional — leave false to disable) ──────────
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=cfo-fitness
PHOENIX_CLIENT_HEADERS=

# ── Agent Builder / A2A Endpoint (Optional) ──────────────────────────────────
AGENT_API_KEY=

# ── Research Tools (Optional Server Fallback) ────────────────────────────────
# Note: Hybrid Ticker Tape includes a built-in zero-network USDA reconciler (`src/lib/usda-local-reconciler.ts`).
USDA_FOOD_API_KEY=

# ── Wearable OAuth Integrations (Optional) ───────────────────────────────────
NEXT_PUBLIC_FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
NEXT_PUBLIC_WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# ── Cron / Background Jobs (Optional) ────────────────────────────────────────
CRON_SECRET=
